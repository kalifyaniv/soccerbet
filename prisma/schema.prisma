generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("player")
  disabled      Boolean   @default(false)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  players       Player[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id              String          @id @default(cuid())
  eventName       String
  description     String?
  startDate       DateTime
  endDate         DateTime
  groupStageEnd   DateTime
  status          String          @default("draft")
  bettingDeadline DateTime
  entryFee        Float           @default(200)
  totalPlayers    Int             @default(0)
  actualTopScorer String?
  actualWinner    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bonusLog        BonusLog[]
  matches         Match[]
  multiplierGame  MultiplierGame?
  players         Player[]
  playerBets      PlayerBet[]
  pointsLog       PointLog[]
}

model Player {
  id          String     @id @default(cuid())
  userId      String?
  eventId     String
  name        String
  email       String
  avatarUrl   String?
  totalPoints Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bonusLog    BonusLog?
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])
  playerBet   PlayerBet?
  pointsLog   PointLog[]

  @@unique([eventId, email])
}

model Match {
  id            String     @id @default(cuid())
  eventId       String
  matchNumber   Int
  groupLetter   String
  teamA         String
  teamB         String
  matchDate     DateTime?
  venue         String?
  status        String     @default("scheduled")
  finalScoreA   Int?
  finalScoreB   Int?
  externalApiId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pointsLog     PointLog[]

  @@unique([eventId, matchNumber])
}

model PlayerBet {
  id                     String    @id @default(cuid())
  playerId               String    @unique
  eventId                String
  groupPredictions       String    @default("{}")
  multiplierGames        String    @default("[]")
  kingOfGoalsPlayer      String    @default("")
  tournamentWinner       String    @default("")
  status                 String    @default("draft")
  submittedAt            DateTime?
  groupStagePoints       Int?
  kingOfGoalsPoints      Int?
  tournamentWinnerPoints Int?
  totalPoints            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  event                  Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player                 Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId])
}

model MultiplierGame {
  id                   String    @id @default(cuid())
  eventId              String    @unique
  matchNumbers         String    @default("[]")
  totalMultiplierGames Int       @default(0)
  duplicateCount       Int       @default(0)
  calculatedAt         DateTime?
  updatedAt            DateTime  @updatedAt
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PointLog {
  id               String   @id @default(cuid())
  playerId         String
  matchId          String
  eventId          String
  matchNumber      Int
  groupLetter      String
  prediction       String
  actualResult     String
  basePoints       Int
  isMultiplier     Boolean  @default(false)
  multiplierFactor Int      @default(1)
  finalPoints      Int
  scoringMethod    String?
  calculatedAt     DateTime @default(now())
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
}

model BonusLog {
  id                           String    @id @default(cuid())
  playerId                     String    @unique
  eventId                      String
  predictedTopScorer           String    @default("")
  actualTopScorer              String?
  kingOfGoalsPoints            Int?
  kingOfGoalsCalculatedAt      DateTime?
  predictedWinner              String    @default("")
  actualWinner                 String?
  tournamentWinnerPoints       Int?
  tournamentWinnerCalculatedAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  event                        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player                       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId])
}
