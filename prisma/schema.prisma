// Soccer Betting App – World Cup 2026
// Both dev and prod use PostgreSQL.
// Dev:  DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soccerbet  (Docker)
// Prod: DATABASE_URL=postgresql://...supabase.co/postgres

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (NextAuth v5) ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("player") // "player" | "admin"
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  players       Player[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── APP MODELS ────────────────────────────────────────────────────────────

model Event {
  id              String   @id @default(cuid())
  eventName       String
  description     String?
  startDate       DateTime
  endDate         DateTime
  groupStageEnd   DateTime
  status          String   @default("draft") // "draft" | "active" | "completed"
  bettingDeadline DateTime
  entryFee        Float    @default(200)
  totalPlayers    Int      @default(0)
  totalPrizePool  Float?
  // Set by admin after each stage:
  actualTopScorer String?
  actualWinner    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players        Player[]
  matches        Match[]
  playerBets     PlayerBet[]
  multiplierGame MultiplierGame?
  pointsLog      PointLog[]
  bonusLog       BonusLog[]
}

// Group model removed – "בית" prizes are calculated dynamically from PointLog.groupLetter.
// e.g. "בית A winner" = player with max sum(finalPoints) WHERE groupLetter = 'A'

model Player {
  id          String   @id @default(cuid())
  userId      String?
  eventId     String
  // groupId removed – players are not assigned to a "בית".
  // "בית winner" prizes are calculated from PointLog filtered by groupLetter.
  name        String
  email       String
  avatarUrl   String?
  totalPoints Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id])
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerBet PlayerBet?
  pointsLog PointLog[]
  bonusLog  BonusLog?

  @@unique([eventId, email])
}

// 72 group-stage matches (A–L, 6 matches per group)
model Match {
  id            String    @id @default(cuid())
  eventId       String
  matchNumber   Int
  groupLetter   String // "A"…"L"
  teamA         String
  teamB         String
  matchDate     DateTime?
  venue         String?
  status        String    @default("scheduled") // "scheduled" | "live" | "completed"
  finalScoreA   Int?
  finalScoreB   Int?
  externalApiId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pointsLog PointLog[]

  @@unique([eventId, matchNumber])
}

// One row per player – locked after submission
model PlayerBet {
  id                     String    @id @default(cuid())
  playerId               String    @unique
  eventId                String
  // JSON: {"1":{"a":1,"b":0},"2":{"a":2,"b":1}, ...}
  groupPredictions       String    @default("{}")
  // JSON: [5,10]
  multiplierGames        String    @default("[]")
  kingOfGoalsPlayer      String    @default("")
  tournamentWinner       String    @default("")
  status                 String    @default("draft") // "draft" | "locked"
  submittedAt            DateTime?
  groupStagePoints       Int?
  kingOfGoalsPoints      Int?
  tournamentWinnerPoints Int?
  totalPoints            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId])
}

// UNION of all player multiplier selections
model MultiplierGame {
  id                   String    @id @default(cuid())
  eventId              String    @unique
  matchNumbers         String    @default("[]") // JSON: [3,5,8,…]
  totalMultiplierGames Int       @default(0)
  duplicateCount       Int       @default(0)
  calculatedAt         DateTime?
  updatedAt            DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Audit trail – one row per player per match after result is entered
model PointLog {
  id               String   @id @default(cuid())
  playerId         String
  matchId          String
  eventId          String
  matchNumber      Int
  groupLetter      String
  prediction       String // JSON {"a":1,"b":0}
  actualResult     String // JSON {"a":0,"b":2}
  basePoints       Int
  isMultiplier     Boolean  @default(false)
  multiplierFactor Int      @default(1)
  finalPoints      Int
  scoringMethod    String? // "exact"|"trend_and_gap"|"winner_or_gap"|"partial"|"wrong"
  calculatedAt     DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
}

// King of Goals + Tournament Winner bonus tracking
model BonusLog {
  id                           String    @id @default(cuid())
  playerId                     String    @unique
  eventId                      String
  predictedTopScorer           String    @default("")
  actualTopScorer              String?
  kingOfGoalsPoints            Int?
  kingOfGoalsCalculatedAt      DateTime?
  predictedWinner              String    @default("")
  actualWinner                 String?
  tournamentWinnerPoints       Int?
  tournamentWinnerCalculatedAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId])
}
